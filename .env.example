# ---- Database ----
# Local dev (default): embedded DuckDB file, no server needed.
DATABASE_URL=duckdb:///./data/demo.duckdb
# Docker / production: read-only Postgres user (see docker-compose.yml).
# DATABASE_URL=postgresql+psycopg://app_readonly:readonly_pw@db:5432/appdb

# ---- LLM ----
# Provider: anthropic | openai | stub  (stub = deterministic offline fallback)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Set the key for your chosen provider. If unset, the app falls back to the
# deterministic stub provider so the pipeline still runs offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Guardrails (all configurable) ----
GUARDRAIL_DEFAULT_ROW_LIMIT=1000
GUARDRAIL_MAX_SUBQUERY_DEPTH=3
GUARDRAIL_MAX_ESTIMATED_ROWS=1000000
GUARDRAIL_STATEMENT_TIMEOUT_MS=5000

# ---- App ----
AUDIT_LOG_PATH=audit.log

# ---- Auth ----
# Separate SQLite users table (bcrypt-hashed passwords); kept apart from the data db.
AUTH_DB_URL=sqlite:///./data/auth.db
# JWT signing key. Leave blank in dev (a random per-process secret is generated,
# so tokens reset on restart). Set a long random value in production for stable sessions.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MIN=720
# Seed a demo account on startup so login works out of the box (demo login below).
AUTH_SEED_DEMO=true
AUTH_DEMO_USER=demo
AUTH_DEMO_PASSWORD=demo12345

# ---- CORS ----
# Empty = same-origin only (the /login page is served by the API, so it needs nothing here).
# Set a comma-separated origin list to host the login page / a frontend elsewhere, e.g.:
# CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOW_ORIGINS=

# ---- Security headers ----
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true          # Strict-Transport-Security, sent on HTTPS responses only
